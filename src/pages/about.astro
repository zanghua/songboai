---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBanner from "../components/PageBanner.astro";
import SectionTitle from "../components/SectionTitle.astro";
import TeamSection from "../components/TeamSection.astro";
import SubsidiarySection from "../components/SubsidiarySection.astro";
import VisionSection from "../components/VisionSection.astro";
import CTASection from "../components/CTASection.astro";
import { brand, milestones } from "../data/site";
---

<BaseLayout title={`关于我们 | ${brand.name}`} description="了解松博教育的发展历程、团队实力与教育服务理念。">
  <PageBanner subtitle="ABOUT US" title="关于" highlight="松博教育" />

  <!-- 公司详细介绍 -->
  <section class="py-20 md:py-28 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-start">
        <div>
          <SectionTitle
            subtitle="OUR STORY"
            title="深耕教育沃土"
            highlight=" 铸就未来"
            centered={false}
          />
          <div class="space-y-5 text-base text-slate-600 leading-relaxed">
            <p>
              <strong class="text-slate-900">{brand.name}</strong>，立足优质教育资源沃土，以“科学规划 + 能力提升”为核心，由资深教育专家与一线教学团队倾力打造，是覆盖从小学到博士全学段的教育服务培训指导提供商。
            </p>
            <p>
              公司汇聚多位教育领域专家，他们深耕教育领域多年，潜心研发松博教育课程，构建了成熟教研体系并实现了规模化教学落地，持续迭代教学服务能力。
            </p>
            <p>
              公司锚定全年级高效学习赋能、自主能力塑造的核心方向，肩负学生成长培育与教育创业服务双重使命，围绕青少年全周期成长与教育从业者发展需求，搭建全流程、一体化教育生态体系。
            </p>
            <p>
              业务涵盖幼小衔接、自主学习能力培养、云伴学、脑象测评、技巧提分、定向择校、单招规划、国际留学与生源升学规划九大板块，是专注全学段教育规划与能力培养的<strong class="text-slate-900">教育服务机构</strong>。
            </p>
          </div>
        </div>

        <!-- 发展历程时间线 -->
        <div>
          <SectionTitle
            subtitle="MILESTONES"
            title="发展历程"
            centered={false}
          />
          <div class="relative pl-8">
            <!-- 时间线竖线 -->
            <div class="absolute left-3 top-2 bottom-2 w-0.5 bg-gradient-to-b from-brand-300 to-brand-600"></div>

            <div class="space-y-8">
              {
                milestones.map((m) => (
                  <div class="relative group">
                    {/* 圆点 */}
                    <div class="absolute -left-[1.65rem] top-1 w-6 h-6 rounded-full bg-white ring-4 ring-brand-100 flex items-center justify-center group-hover:ring-brand-300 transition-all">
                      <div class="w-2.5 h-2.5 rounded-full bg-gradient-to-br from-brand-500 to-brand-700" />
                    </div>
                    <div class="bg-slate-50 rounded-xl p-5 group-hover:bg-brand-50 group-hover:shadow-md transition-all duration-300">
                      <div class="flex items-center gap-3 mb-2">
                        <span class="text-2xl font-black text-gradient-brand">{m.year}</span>
                        <span class="text-base font-bold text-slate-800">{m.title}</span>
                      </div>
                      <p class="text-sm text-slate-500 leading-relaxed">{m.description}</p>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 团队展示 -->
  <TeamSection />

  <!-- 子公司集群 -->
  <SubsidiarySection />

  <!-- 愿景使命 -->
  <VisionSection />

  <!-- CTA -->
  <CTASection />
</BaseLayout>
