---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBanner from "../components/PageBanner.astro";
import ContactForm from "../components/ContactForm.astro";
import { brand } from "../data/site";

const contactCards = [
  {
    title: "电话咨询",
    value: brand.phone,
    sub: "周一至周日 9:00-21:00",
    icon: "M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z",
  },
  {
    title: "微信咨询",
    value: brand.wechat,
    sub: "工作时间随时沟通",
    icon: "M8 10h.01M12 10h.01M16 10h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z",
  },
  {
    title: "邮箱联系",
    value: brand.email,
    sub: "24小时内回复",
    icon: "M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
  },
  {
    title: "公司地址",
    value: brand.address,
    sub: "欢迎莅临参观",
    icon: "M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z",
  },
];
---

<BaseLayout title={`联系我们 | ${brand.name}`} description="联系松博教育，获取全学段教育规划与能力培养咨询服务，电话、微信、邮箱、地址一站式沟通。">
  <PageBanner subtitle="CONTACT" title="联系" highlight="我们" />

  <!-- 联系信息卡片 -->
  <section class="py-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          contactCards.map((card, i) => (
            <div
              class="group relative bg-gradient-to-br from-slate-50 to-white rounded-2xl p-8 shadow-[var(--shadow-card)] hover:shadow-[var(--shadow-card-hover)] border border-slate-100 transition-all duration-300"
              style={`animation: fadeInUp 0.5s ease-out forwards; animation-delay: ${i * 0.1}s; opacity: 0;`}
            >
              <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-brand-600 to-brand-800 flex items-center justify-center mb-6 shadow-lg shadow-brand-600/20 group-hover:scale-110 transition-transform duration-300">
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={card.icon} />
                </svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">{card.title}</h3>
              <p class="text-base md:text-lg font-bold text-brand-700 mb-1 break-all">{card.value}</p>
              <p class="text-sm text-slate-400">{card.sub}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 在线表单 -->
  <ContactForm />

  <!-- 地址区域 -->
  <section class="py-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-3xl overflow-hidden shadow-xl">
        <div class="bg-gradient-to-r from-brand-900 to-brand-700 px-8 py-6">
          <h3 class="text-xl font-bold text-white flex items-center gap-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            公司总部地址
          </h3>
        </div>
        <div class="bg-slate-100 p-8 md:p-12">
          <div class="grid md:grid-cols-2 gap-8 items-center">
            <div>
              <p class="text-lg font-bold text-slate-900 mb-3">{brand.address}</p>
              <p class="text-slate-500 leading-relaxed mb-6">
                松博教育总部位于濮阳市华龙区，交通便利，环境优美。欢迎广大家长、学员及合作伙伴莅临参观交流。
              </p>
              <div class="flex flex-wrap gap-3">
                <a
                  href={`tel:${brand.phone}`}
                  class="inline-flex items-center gap-2 px-6 py-3 bg-brand-600 text-white font-semibold rounded-xl shadow-lg shadow-brand-600/30 hover:bg-brand-700 transition-colors"
                >
                  拨打电话
                </a>
                <a
                  href={`mailto:${brand.email}`}
                  class="inline-flex items-center gap-2 px-6 py-3 bg-slate-200 text-slate-700 font-semibold rounded-xl hover:bg-slate-300 transition-colors"
                >
                  发送邮件
                </a>
                <span class="inline-flex items-center gap-2 px-6 py-3 bg-brand-50 text-brand-700 font-semibold rounded-xl border border-brand-100">
                  微信咨询 {brand.wechat}
                </span>
              </div>
            </div>
            <!-- 地图定位 -->
            <a
              href="https://uri.amap.com/marker?position=115.0290,35.7627&name=松博教育（胜利路尚城大厦1105室）&coordinate=gaode&callnative=1"
              target="_blank"
              rel="noopener noreferrer"
              class="block aspect-video rounded-2xl overflow-hidden relative shadow-inner group"
            >
              <div
                class="absolute inset-0 bg-gradient-to-br from-brand-50 to-brand-200"
                style="background-image: linear-gradient(rgba(30,58,138,0.08) 1px, transparent 1px), linear-gradient(90deg, rgba(30,58,138,0.08) 1px, transparent 1px); background-size: 40px 40px;"
              >
              </div>
              <!-- 模拟道路线条 -->
              <svg class="absolute inset-0 w-full h-full opacity-30" viewBox="0 0 400 225" preserveAspectRatio="none">
                <path d="M0,120 Q100,80 200,110 T400,90" stroke="rgba(30,58,138,0.4)" stroke-width="6" fill="none" />
                <path d="M0,160 Q150,140 250,165 T400,150" stroke="rgba(30,58,138,0.3)" stroke-width="4" fill="none" />
                <path d="M120,0 Q140,80 110,150 T130,225" stroke="rgba(30,58,138,0.3)" stroke-width="4" fill="none" />
                <path d="M280,0 Q260,100 290,180 T270,225" stroke="rgba(30,58,138,0.25)" stroke-width="3" fill="none" />
              </svg>
              <!-- 中心定位标记 -->
              <div class="absolute inset-0 flex flex-col items-center justify-center">
                <div class="relative">
                  <div class="absolute -inset-3 rounded-full bg-brand-500/20 animate-ping"></div>
                  <div class="relative w-12 h-12 rounded-full bg-brand-600 flex items-center justify-center shadow-lg">
                    <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 010-5 2.5 2.5 0 010 5z"/>
                    </svg>
                  </div>
                </div>
                <p class="mt-4 text-sm font-semibold text-brand-800">{brand.name}</p>
                <p class="text-xs text-brand-600 mt-0.5">{brand.address}</p>
                <span class="mt-3 inline-flex items-center gap-1 text-xs text-brand-600 group-hover:text-brand-700 font-medium">
                  点击查看高德地图导航
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </span>
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
