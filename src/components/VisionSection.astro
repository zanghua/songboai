---
import { vision } from "../data/site";
import SectionTitle from "./SectionTitle.astro";
---

<section class="py-20 md:py-28 bg-gradient-to-br from-brand-950 via-brand-900 to-brand-800 relative overflow-hidden">
  <div class="absolute top-0 left-1/3 w-[600px] h-[600px] bg-brand-500/15 rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-accent-500/10 rounded-full blur-3xl"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionTitle
      subtitle="VISION & MISSION"
      title="让成长"
      highlight=" 更有方向"
      centered={true}
      light={true}
    />

    <div class="max-w-4xl mx-auto text-center mb-16">
      <p class="text-xl md:text-2xl text-white/90 font-medium leading-relaxed">
        公司力践<span class="text-accent-400">双端并行</span>发展理念，以<span class="text-brand-300">利国、利民、利教</span>为愿景，以使命与价值观驱动前行。
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-6 mb-12 max-w-5xl mx-auto">
      <div class="group relative bg-white/5 backdrop-blur-md rounded-3xl p-8 border border-white/10 hover:bg-white/10 hover:border-brand-400/30 transition-all duration-300">
        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-brand-400 to-brand-600 flex items-center justify-center mb-6 shadow-lg shadow-brand-900/50 group-hover:scale-110 transition-transform duration-300">
          <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-white mb-4">企业愿景</h3>
        <p class="text-base text-slate-300 leading-relaxed">{vision.vision}</p>
      </div>

      <div class="group relative bg-white/5 backdrop-blur-md rounded-3xl p-8 border border-white/10 hover:bg-white/10 hover:border-accent-400/30 transition-all duration-300">
        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-accent-400 to-accent-600 flex items-center justify-center mb-6 shadow-lg shadow-accent-900/50 group-hover:scale-110 transition-transform duration-300">
          <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-white mb-4">企业使命</h3>
        <p class="text-base text-slate-300 leading-relaxed">{vision.mission}</p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-5xl mx-auto">
      {
        vision.values.map((val, i) => (
          <div
            class="text-center group"
            style={`animation: fadeInUp 0.5s ease-out forwards; animation-delay: ${i * 0.15}s; opacity: 0;`}
          >
            <div class="relative inline-block mb-5">
              <div class="text-7xl font-black text-gradient-brand leading-none">
                {val.title}
              </div>
            </div>
            <p class="text-sm text-slate-400 leading-relaxed">{val.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
