---
import { services } from "../data/site";
---

<section class="py-20 md:py-28 bg-slate-50">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <div class="bg-white rounded-3xl shadow-xl shadow-slate-200/50 p-8 md:p-12">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-slate-900">在线预约咨询</h2>
        <p class="mt-3 text-slate-500">填写以下信息，我们的顾问将在24小时内与您联系</p>
      </div>

      <form class="space-y-5" onsubmit="return false;">
        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-2">姓名 <span class="text-red-500">*</span></label>
            <input
              type="text"
              required
              placeholder="请输入您的姓名"
              class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-100 outline-none transition-all"
            />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-2">手机号码 <span class="text-red-500">*</span></label>
            <input
              type="tel"
              required
              pattern="1[3-9]\d{9}"
              placeholder="请输入您的手机号码"
              class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-100 outline-none transition-all"
            />
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-2">感兴趣的课程</label>
          <select class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-100 outline-none transition-all">
            <option value="">请选择课程类型</option>
            {services.map((s) => <option>{s.title}</option>)}
            <option>其他</option>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-2">留言内容</label>
          <textarea
            rows="4"
            placeholder="请简要描述您的需求或问题..."
            class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-100 outline-none transition-all resize-none"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full py-4 bg-gradient-to-r from-brand-900 to-brand-700 text-white font-bold rounded-xl shadow-lg shadow-brand-900/30 hover:shadow-xl hover:scale-[1.02] transition-all duration-300"
        >
          提交预约
        </button>
        <p class="text-center text-xs text-slate-400">
          提交即表示您同意我们的隐私政策，您的信息将被严格保密
        </p>
      </form>
    </div>
  </div>
</section>
