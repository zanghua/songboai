---
import { team } from "../data/site";
import SectionTitle from "./SectionTitle.astro";

const colors = [
  "from-brand-600 to-brand-800",
  "from-sky-500 to-brand-700",
  "from-accent-500 to-accent-700",
  "from-brand-700 to-slate-800",
];
---

<section class="py-20 md:py-28 bg-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionTitle
      subtitle="OUR TEAM"
      title="汇聚顶尖"
      highlight="教育专家"
    />

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        team.map((member, i) => (
          <div
            class="group bg-white rounded-2xl overflow-hidden shadow-[var(--shadow-card)] hover:shadow-[var(--shadow-card-hover)] transition-all duration-300 border border-slate-100"
            style={`animation: fadeInUp 0.5s ease-out forwards; animation-delay: ${i * 0.1}s; opacity: 0;`}
          >
            {/* 头像区 */}
            <div class={`relative h-48 bg-gradient-to-br ${colors[i % colors.length]} flex items-center justify-center overflow-hidden`}>
              <div class="absolute inset-0 opacity-10" style="background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 20px 20px;" />
              <div class="relative text-6xl font-black text-white/90 group-hover:scale-110 transition-transform duration-500">
                {member.name.charAt(0)}
              </div>
              <div class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-black/30 to-transparent" />
            </div>

            {/* 信息区 */}
            <div class="p-6">
              <h3 class="text-lg font-bold text-slate-900">{member.name}</h3>
              <p class="text-sm text-brand-600 font-medium mt-1">{member.title}</p>
              <p class="mt-4 text-sm text-slate-500 leading-relaxed">
                {member.description}
              </p>

              {/* 专长标签 */}
              <div class="mt-5 flex flex-wrap gap-2">
                {member.expertise.map((skill) => (
                  <span class="px-2.5 py-1 rounded-md bg-slate-50 text-slate-500 text-xs font-medium ring-1 ring-slate-100">
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
