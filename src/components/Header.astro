---
import { brand, navItems } from "../data/site";

const currentPath = Astro.url.pathname;
---

<!-- 导航栏 -->
<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <nav class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div
      id="nav-inner"
      class="flex items-center justify-between h-16 transition-all duration-300 mt-3 rounded-2xl"
    >
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <div
          class="flex items-center justify-center w-10 h-10 rounded-xl bg-gradient-to-br from-brand-900 to-brand-600 text-white font-bold text-lg shadow-lg shadow-brand-600/30 group-hover:scale-110 transition-transform duration-300"
        >
          松
        </div>
        <div class="hidden sm:block">
          <div class="text-lg font-bold text-white tracking-tight leading-none">
            {brand.name}
          </div>
          <div class="text-[10px] text-white/70 tracking-widest font-medium mt-0.5">
            {brand.nameEn}
          </div>
        </div>
      </a>

      <!-- 桌面端导航 -->
      <div class="hidden md:flex items-center gap-1">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                "relative px-4 py-2 text-sm font-medium rounded-lg transition-all duration-200",
                currentPath === item.href
                  ? "text-white bg-white/15"
                  : "text-white/80 hover:text-white hover:bg-white/10",
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </div>

      <!-- CTA 按钮 + 移动端菜单按钮 -->
      <div class="flex items-center gap-3">
        <a
          href="/contact"
          class="hidden sm:inline-flex items-center px-5 py-2 text-sm font-semibold text-brand-900 bg-white rounded-xl shadow-md hover:shadow-lg hover:scale-105 transition-all duration-200"
        >
          免费咨询
        </a>

        <!-- 移动端汉堡菜单 -->
        <button
          id="mobile-menu-btn"
          class="md:hidden flex items-center justify-center w-10 h-10 rounded-lg text-white hover:bg-white/10 transition-colors"
          aria-label="菜单"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <!-- 移动端折叠菜单 -->
  <div
    id="mobile-menu"
    class="md:hidden hidden mx-4 mt-2 rounded-2xl bg-white shadow-2xl ring-1 ring-black/5 overflow-hidden transition-all duration-300"
  >
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            "block px-6 py-4 text-base font-medium border-b border-slate-100 last:border-0 transition-colors",
            currentPath === item.href
              ? "text-brand-600 bg-brand-50"
              : "text-slate-700 hover:bg-slate-50",
          ]}
        >
          {item.label}
        </a>
      ))
    }
    <a
      href="/contact"
      class="block px-6 py-4 text-center text-base font-semibold text-white bg-gradient-to-r from-brand-900 to-brand-600"
    >
      免费咨询
    </a>
  </div>
</header>

<script>
  // 滚动时导航栏样式变化
  const navInner = document.getElementById("nav-inner");

  function onScroll() {
    const scrollY = window.scrollY;
    if (scrollY > 30) {
      navInner?.classList.add("backdrop-blur-xl", "bg-brand-900/90", "shadow-lg");
      navInner?.classList.remove("mt-3");
    } else {
      navInner?.classList.remove("backdrop-blur-xl", "bg-brand-900/90", "shadow-lg");
      navInner?.classList.add("mt-3");
    }
  }

  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  // 移动端菜单
  const menuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  menuBtn?.addEventListener("click", () => {
    mobileMenu?.classList.toggle("hidden");
  });
</script>
