  upgrade: "M13 7h8m0 0v8m0-8l-8 8-4-4-6 6",
  ielts: "M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.75 1l5.25 5.25L12.75 11.5",
