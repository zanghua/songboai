  psychology: "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z",
  comprehensive: "M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z",
};
---

<section class="py-20 md:py-28 bg-slate-50 relative overflow-hidden">
  <div class="absolute top-0 right-0 w-72 h-72 bg-brand-100/50 rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 left-0 w-96 h-96 bg-accent-100/30 rounded-full blur-3xl"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionTitle
      subtitle="CORE SERVICES"
      title="十二大服务板块"
      highlight=" 全方位覆盖"
    />

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5">
      {
        services.map((service, i) => (
          <div
            class="group relative bg-white rounded-2xl p-6 shadow-[var(--shadow-card)] hover:shadow-[var(--shadow-card-hover)] hover:-translate-y-2 transition-all duration-300 cursor-pointer border border-slate-100"
            style={`animation: fadeInUp 0.5s ease-out forwards; animation-delay: ${i * 0.05}s; opacity: 0;`}
          >
            <div class="absolute top-0 left-6 right-6 h-1 rounded-full bg-gradient-to-r from-brand-600 to-brand-400 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left" />

            <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-brand-50 to-brand-100 flex items-center justify-center mb-5 group-hover:from-brand-600 group-hover:to-brand-700 transition-all duration-300">
              <svg
                class="w-7 h-7 text-brand-600 group-hover:text-white transition-colors duration-300"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d={iconMap[service.icon]}
                />
              </svg>
            </div>

            <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-brand-700 transition-colors">
              {service.title}
            </h3>
            <p class="text-sm text-slate-500 leading-relaxed">
              {service.description}
            </p>

            <div class="mt-4">
              <span class="inline-block px-2.5 py-1 rounded-md bg-slate-100 text-slate-500 text-xs font-medium">
                {service.category}
              </span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
