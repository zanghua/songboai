---
import { stats } from "../data/site";
---

<section class="relative overflow-hidden">
  <div class="bg-gradient-to-r from-brand-900 via-brand-800 to-brand-900">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-14">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
        {
          stats.map((stat, i) => (
            <div
              class="text-center relative group"
              style={`animation: fadeInUp 0.6s ease-out forwards; animation-delay: ${i * 0.1}s; opacity: 0;`}
            >
              {i > 0 && (
                <div class="hidden lg:block absolute -left-4 top-1/2 -translate-y-1/2 h-12 w-px bg-white/15" />
              )}
              <div class="text-4xl lg:text-5xl font-black text-white tracking-tight group-hover:text-brand-300 transition-colors">
                {stat.value}
              </div>
              <div class="mt-2 text-sm text-brand-200 font-medium">
                {stat.label}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
