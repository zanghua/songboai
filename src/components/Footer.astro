---
import { brand, navItems, services } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-300">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      <!-- 品牌简介 -->
      <div class="lg:col-span-1">
        <div class="flex items-center gap-3 mb-5">
          <div
            class="flex items-center justify-center w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 text-white font-bold text-lg"
          >
            松
          </div>
          <div>
            <div class="text-lg font-bold text-white">{brand.name}</div>
            <div class="text-[10px] text-slate-500 tracking-widest">
              {brand.nameEn}
            </div>
          </div>
        </div>
        <p class="text-sm text-slate-400 leading-relaxed">
          {brand.description}
        </p>
      </div>

      <!-- 快捷导航 -->
      <div>
        <h3 class="text-white font-semibold mb-5">快速导航</h3>
        <ul class="space-y-3">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-slate-400 hover:text-brand-400 transition-colors"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- 服务板块 -->
      <div>
        <h3 class="text-white font-semibold mb-5">服务板块</h3>
        <ul class="space-y-3">
          {
            services.slice(0, 6).map((item) => (
              <li>
                <a
                  href="/courses"
                  class="text-sm text-slate-400 hover:text-brand-400 transition-colors"
                >
                  {item.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- 联系方式 -->
      <div>
        <h3 class="text-white font-semibold mb-5">联系我们</h3>
        <ul class="space-y-3 text-sm text-slate-400">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 mt-0.5 text-brand-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>{brand.phone}</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 mt-0.5 text-brand-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span>{brand.email}</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 mt-0.5 text-brand-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>{brand.address}</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- 底部版权 -->
    <div class="mt-12 pt-8 border-t border-slate-800">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-slate-500">
        <p>© {year} {brand.name}科技有限公司 · All Rights Reserved</p>
        <a
          href="https://beian.miit.gov.cn/"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-slate-300 transition-colors"
        >
          {brand.icp}
        </a>
      </div>
    </div>
  </div>
</footer>
