---
import { brand } from "../data/site";
---

<section class="py-20 md:py-28 bg-white relative overflow-hidden">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="relative rounded-[2.5rem] overflow-hidden">
      <!-- 渐变背景 -->
      <div class="absolute inset-0 bg-gradient-to-r from-brand-900 via-brand-800 to-brand-700"></div>

      <!-- 装饰元素 -->
      <div class="absolute top-0 right-0 w-80 h-80 bg-white/5 rounded-full blur-3xl -translate-y-1/3 translate-x-1/3"></div>
      <div class="absolute bottom-0 left-0 w-60 h-60 bg-accent-500/10 rounded-full blur-3xl translate-y-1/3 -translate-x-1/3"></div>
      <div
        class="absolute inset-0 opacity-10"
        style="background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 50px 50px;"
      >
      </div>

      <!-- 内容 -->
      <div class="relative px-8 py-16 md:px-16 md:py-20 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-5">
          开启孩子的<span class="text-accent-400">逐光之旅</span>
        </h2>
        <p class="text-lg text-slate-300 max-w-2xl mx-auto mb-10 leading-relaxed">
          免费获取专业教育规划方案，松博教育规划师一对一为您量身定制学习路径。
        </p>
        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            href="/contact"
            class="group inline-flex items-center gap-2 px-8 py-4 bg-white text-brand-900 font-bold rounded-xl shadow-2xl shadow-brand-950/50 hover:scale-105 transition-all duration-300"
          >
            免费预约咨询
            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a
            href={`tel:${brand.phone}`}
            class="inline-flex items-center gap-2 px-8 py-4 bg-white/10 backdrop-blur-md text-white font-bold rounded-xl border border-white/30 hover:bg-white/20 hover:scale-105 transition-all duration-300"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            {brand.phone}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
