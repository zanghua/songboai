---
import SectionTitle from "./SectionTitle.astro";
import { brand, puyangZone } from "../data/site";
---

<section class="py-20 md:py-28 bg-gradient-to-br from-brand-950 via-brand-900 to-brand-800 relative overflow-hidden">
  <div class="absolute top-0 left-1/3 w-[600px] h-[600px] bg-brand-500/15 rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-accent-500/10 rounded-full blur-3xl"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionTitle
      subtitle="PUYANG LOCAL"
      title="濮阳本地"
      highlight=" 升学辅导专区"
      light={true}
    />

    <p class="text-center text-slate-300 text-lg leading-relaxed max-w-2xl mx-auto mb-12">
      深耕濮阳本地的小升初、中考、单招升学辅导服务，考前规划与专项训练并重，帮助孩子找准方向、稳步提升。
    </p>

    <!-- 三大升学辅导 -->
    <div class="grid md:grid-cols-3 gap-6 mb-12">
      {
        puyangZone.programs.map((program, i) => (
          <div
            class="group relative bg-white/5 backdrop-blur-md rounded-3xl p-8 border border-white/10 hover:bg-white/10 hover:border-brand-400/30 transition-all duration-300"
            style={`animation: fadeInUp 0.5s ease-out forwards; animation-delay: ${i * 0.1}s; opacity: 0;`}
          >
            <div
              class="w-14 h-14 rounded-2xl bg-gradient-to-br from-brand-400 to-brand-600 flex items-center justify-center mb-6 shadow-lg shadow-brand-900/50 group-hover:scale-110 transition-transform duration-300"
            >
              <span class="text-lg font-black text-white">0{i + 1}</span>
            </div>
            <h3 class="text-2xl font-bold text-white mb-4">{program.title}</h3>
            <p class="text-base text-slate-300 leading-relaxed">
              {program.description}
            </p>
          </div>
        ))
      }
    </div>

    <!-- 签约保障 -->
    <div class="flex justify-center mb-12">
      <div
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-accent-400/10 border border-accent-400/30 text-accent-300 font-semibold"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
          />
        </svg>
        {puyangZone.guarantee}
      </div>
    </div>

    <!-- 本地联系方式 -->
    <div class="flex flex-wrap justify-center gap-4">
      <a
        href={`tel:${brand.phone}`}
        class="inline-flex items-center gap-2 px-6 py-3 bg-white text-brand-900 font-bold rounded-xl shadow-xl shadow-brand-950/40 hover:scale-105 transition-all duration-300"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
          />
        </svg>
        咨询热线 {brand.phone}
      </a>
      <span
        class="inline-flex items-center gap-2 px-6 py-3 bg-white/10 backdrop-blur-md text-white font-semibold rounded-xl border border-white/20"
      >
        微信 {brand.wechat}
      </span>
      <span
        class="inline-flex items-center gap-2 px-6 py-3 bg-white/10 backdrop-blur-md text-white font-semibold rounded-xl border border-white/20"
      >
        {brand.address}
      </span>
    </div>
  </div>
</section>
